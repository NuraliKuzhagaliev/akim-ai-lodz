# Live backend. Use mock only for the clearly marked static interface demo.
NEXT_PUBLIC_API_MODE=live
# In live mode: backend origin (without /api), or empty for same-origin routing.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Agreed /api/recommend endpoint. Enabled by default in live mode; false opts out.
NEXT_PUBLIC_ENABLE_RECOMMENDATIONS=true
# Trusted backend comparison of two independently recalculated scenarios.
NEXT_PUBLIC_ENABLE_AI_COMPARISON=true
